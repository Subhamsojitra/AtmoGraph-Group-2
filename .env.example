APP_NAME=AtmoGraph API
APP_VERSION=0.1.0
LOG_LEVEL=INFO

NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me
NEO4J_DATABASE=neo4j

# NLP settings (Module 7 - preprocessing & NER)
# NLP_MODEL_NAME must already be installed locally (see README); it is never
# downloaded automatically by the application or the test suite.
NLP_MODEL_NAME=dslim/bert-base-NER
NLP_NER_MAX_LENGTH=512
NLP_MAX_TEXT_LENGTH=10000
NLP_DEVICE=cpu
NLP_USE_FAST_TOKENIZER=true

# Risk state update (Module 9).
# Risk score scale is 0-100. Risk levels are derived using the thresholds
# below, which are a documented ASSUMPTION (not an official spec value).
RISK_SCORE_MIN=0
RISK_SCORE_MAX=100
RISK_LEVEL_MEDIUM=31
RISK_LEVEL_HIGH=71
RISK_LEVEL_CRITICAL=91

# Risk propagation / ripple effect (Module 10).
# Starting from a resolved entity with a Module 9 risk score, propagate risk
# downstream through the supply chain. Propagated risk at depth d =
# source_score * attenuation ** d (clamped to 0-100). These are documented
# ASSUMPTIONS (no official spec values yet) and are tunable via env vars.
RISK_PROPAGATION_MAX_DEPTH=5
RISK_PROPAGATION_ATTENUATION=0.5
RISK_PROPAGATION_MAX_AFFECTED=500
